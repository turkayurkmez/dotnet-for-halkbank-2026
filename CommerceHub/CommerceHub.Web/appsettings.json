{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    },
    "Limits": {

      "MaxRequestBodySize": "1048576"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CommerceSettings": {
    "DefaultCurrency": "TRY",
    "MaxOrderItemCount": 20
  },
  "AllowedHosts": "*"
}
